# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

# Raw source data -- large, external, re-downloadable. SOURCES.md (checksums,
# URLs, licence) is committed; the data itself is not.
data/raw/*
!data/raw/SOURCES.md

# Sampler output on the way to the frozen selection. Never the frozen
# selection itself -- fixtures/frozen/ is committed and is a different path.
fixtures/derived/*
!fixtures/derived/.gitkeep

# Secrets
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db


# Web UI (ui/web). The built client is a build artifact; the API serves it
# from ui/web/dist when present. `dist/` above already matches it, but it is
# named here too so the reason is recorded next to node_modules.
node_modules/
ui/web/dist/
*.tsbuildinfo

# Resume state for long live eval runs (tools/run_eval.py --resume). Working
# state, not a result: the numbers that matter go in the README, and the
# provenance (which dates were measured) is printed with the report.
evals/runs/

# Durable UI state (DOCKET_UI_STATE_DB default): checkpoints, supplier memory,
# audit trail and run records. Working state of a local server, not a result.
data/runtime/

# CAP mock ERP seed data: generated from the frozen fixtures by
# tools/export_erp_mock_data.py, never committed, so it cannot drift from them.
erp-mock/db/data/
